{
  "name": "Fuconsa Gastronomic Design Tokens",
  "version": "1.1.0",
  "style": "editorial-gastronomico",
  "colorTheory": "harmonized-complementary-60-30-10",
  "colors": {
    "primary": "#253B91",
    "secondary": "#0284C7",
    "accentCulinary": "#C87413",
    "bgScreen": "#F8F9FC",
    "bgPrint": "#FFFFFF",
    "text": "#141A29",
    "muted": "#64708A",
    "border": "#E8ECF4",
    "sectors": {
      "horeca": "#253B91",
      "super": "#0284C7",
      "latinos": "#D97706",
      "acai": "#5B1B52",
      "acaiSecondary": "#15803D"
    }
  },
  "typography": {
    "fontFamily": "Plus Jakarta Sans, Inter, -apple-system, sans-serif",
    "fontFamilyHeading": "Cinzel, Plus Jakarta Sans, Georgia, serif",
    "numericVariant": "tabular-nums"
  },
  "cards": {
    "radius": "12px",
    "border": "1px solid #E8ECF4",
    "borderStyle": "clean-luminous"
  },
  "print": {
    "pageSize": "A4",
    "orientation": "portrait",
    "width": "210mm",
    "height": "297mm",
    "margin": "0mm",
    "contentPadding": "8mm"
  }
}
